/* Rush Drive - Console Racing Game
 * Language: C (Windows / Dev-C++)
 * Controls:
 * [A] Left  [D] Right
 * [P] Pause [Q] Quit
 * [R] Restart after Game Over
 */

#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <conio.h>
#include <windows.h>

#define W 25
#define H 22
#define MAX_CARS 3

int playerX = 12;
int score = 0;
int highScore = 0;
int offset = 0;
int lives = 3;
int nearMisses = 0;
int paused = 0;

int enemyX[MAX_CARS];
int enemyY[MAX_CARS];
int active[MAX_CARS] = {0, 0, 0};

int baseDelay = 50;
int spawnChance = 15;

/* Move cursor to the top-left corner */
void moveCursor(void)
{
    COORD p;
    p.X = 0;
    p.Y = 0;

    SetConsoleCursorPosition(
        GetStdHandle(STD_OUTPUT_HANDLE), p);
}

/* Hide the blinking cursor */
void hideCursor(void)
{
    CONSOLE_CURSOR_INFO ci;

    ci.dwSize = 1;
    ci.bVisible = FALSE;

    SetConsoleCursorInfo(
        GetStdHandle(STD_OUTPUT_HANDLE), &ci);
}

/* Select difficulty */
void selectDifficulty(void)
{
    char choice;

    system("cls");

    printf("\n   ===========================\n");
    printf("         SELECT DIFFICULTY\n");
    printf("   ===========================\n");
    printf("     [1] Easy\n");
    printf("     [2] Medium\n");
    printf("     [3] Hard\n");
    printf("   ===========================\n");
    printf("   Choose (1-3): ");

    while (1)
    {
        choice = getch();

        if (choice == '1')
        {
            baseDelay = 75;
            spawnChance = 24;
            break;
        }
        else if (choice == '2')
        {
            baseDelay = 55;
            spawnChance = 18;
            break;
        }
        else if (choice == '3')
        {
            baseDelay = 40;
            spawnChance = 13;
            break;
        }
    }
}

/* Create an enemy with enough space from other cars */
void createEnemy(void)
{
    int i, j, attempts;
    int newX;
    int safe;
    int freeSlot;

    for (attempts = 0; attempts < 8; attempts++)
    {
        newX = 4 + rand() % 17;
        safe = 1;
        freeSlot = -1;

        for (i = 0; i < MAX_CARS; i++)
        {
            if (!active[i] && freeSlot == -1)
                freeSlot = i;

            if (active[i])
            {
                /* Keep cars separated vertically */
                if (enemyY[i] < 8)
                {
                    safe = 0;
                    break;
                }

                /* Keep enough horizontal distance */
                if (abs(enemyX[i] - newX) < 5 &&
                    enemyY[i] < 12)
                {
                    safe = 0;
                    break;
                }
            }
        }

        if (safe && freeSlot != -1)
        {
            enemyX[freeSlot] = newX;
            enemyY[freeSlot] = 0;
            active[freeSlot] = 1;
            return;
        }
    }
}

/* Move traffic and award points */
void moveEnemies(void)
{
    int i;

    for (i = 0; i < MAX_CARS; i++)
    {
        if (active[i])
        {
            enemyY[i]++;

            if (enemyY[i] >= H - 1)
            {
                /* Bonus for a close, safe pass */
                if (abs(enemyX[i] - playerX) > 2 &&
                    abs(enemyX[i] - playerX) <= 4)
                {
                    score += 3;
                    nearMisses++;
                }

                score++;
                active[i] = 0;
            }
        }
    }
}

/* Detect collision with player */
int collision(void)
{
    int i;

    for (i = 0; i < MAX_CARS; i++)
    {
        if (active[i] &&
            abs(enemyX[i] - playerX) <= 2 &&
            enemyY[i] >= H - 4 &&
            enemyY[i] <= H - 2)
        {
            return 1;
        }
    }

    return 0;
}

/* Keyboard controls */
void controls(void)
{
    int key;

    while (kbhit())
    {
        key = getch();

        if (key == 'a' || key == 'A')
        {
            if (playerX > 4)
                playerX -= 2;
        }
        else if (key == 'd' || key == 'D')
        {
            if (playerX < W - 5)
                playerX += 2;
        }
        else if (key == 'p' || key == 'P')
        {
            paused = !paused;
        }
        else if (key == 'q' || key == 'Q')
        {
            exit(0);
        }
    }
}

/* Draw the road, cars and information */
void drawGame(int speedLevel)
{
    char road[H][W + 1];
    int x, y, i;
    int warning;

    warning = 0;

    for (y = 0; y < H; y++)
    {
        for (x = 0; x < W; x++)
            road[y][x] = ' ';

        road[y][0] = '#';
        road[y][W - 1] = '#';

        if ((y + offset) % 4 < 2)
        {
            road[y][8] = '|';
            road[y][16] = '|';
        }

        road[y][W] = '\0';
    }

    /* Draw enemy cars */
    for (i = 0; i < MAX_CARS; i++)
    {
        if (active[i] &&
            enemyY[i] >= 0 &&
            enemyY[i] < H - 1)
        {
            x = enemyX[i];
            y = enemyY[i];

            road[y][x - 1] = '[';
            road[y][x] = '#';
            road[y][x + 1] = ']';

            road[y + 1][x - 1] = 'o';
            road[y + 1][x] = '-';
            road[y + 1][x + 1] = 'o';

            if (y >= H - 7 &&
                abs(x - playerX) <= 4)
            {
                warning = 1;
            }
        }
    }

    /* Draw player's car */
    road[H - 3][playerX - 1] = '/';
    road[H - 3][playerX] = 'H';
    road[H - 3][playerX + 1] = '\\';

    road[H - 2][playerX - 1] = 'O';
    road[H - 2][playerX] = '-';
    road[H - 2][playerX + 1] = 'O';

    moveCursor();

    for (y = 0; y < H; y++)
        printf("%s\n", road[y]);

    printf(" SCORE: %-6d HIGH SCORE: %d\n",
           score, highScore);

    printf(" LIVES: %d   SPEED LEVEL: %d\n",
           lives, speedLevel);

    printf(" NEAR MISSES: %d\n", nearMisses);
    printf("[A] Left [D] Right [P] Pause [Q] Quit\n");

    if (warning)
        printf(" WARNING! TRAFFIC CLOSE!       \n");
    else
        printf("                                \n");

    if (paused)
        printf("\n          GAME PAUSED\n");
    else
        printf("\n                         \n");
}

/* Main function */
int main(void)
{
    int frame;
    int speedLevel;
    int delay;
    int key;
    int i;
    int gameOver;
    int spawnRoll;

    srand((unsigned int)time(NULL));
    hideCursor();

    while (1)
    {
        selectDifficulty();

        /* Reset game */
        playerX = 12;
        score = 0;
        lives = 3;
        offset = 0;
        frame = 0;
        nearMisses = 0;
        paused = 0;
        gameOver = 0;

        for (i = 0; i < MAX_CARS; i++)
            active[i] = 0;

        system("cls");

        printf("\n        RUSH DRIVE\n");
        printf("============================\n");
        printf("Avoid traffic and survive!\n");
        printf("Lives: 3\n\n");
        printf("A = Left\n");
        printf("D = Right\n");
        printf("P = Pause / Resume\n");
        printf("Q = Quit\n\n");
        printf("Press any key to start...");

        getch();
        system("cls");

        /* Gameplay loop */
        while (!gameOver)
        {
            controls();

            if (paused)
            {
                drawGame(1);
                Sleep(100);
                continue;
            }

            /* Speed increases every 10 points */
            speedLevel = 1 + score / 10;

            if (speedLevel > 8)
                speedLevel = 8;

            delay = baseDelay - (speedLevel - 1) * 4;

            if (delay < 20)
                delay = 20;

            frame++;

            /* Move cars at a steady interval */
            if (frame % 3 == 0)
            {
                moveEnemies();
                offset++;
            }

            /* Traffic spawns with random variation */
            spawnRoll = rand() % 100;

            if (spawnRoll < spawnChance)
                createEnemy();

            /* Handle crash: lose one life */
            if (collision())
            {
                lives--;

                /* Clear cars close to the player */
                for (i = 0; i < MAX_CARS; i++)
                {
                    if (active[i] &&
                        abs(enemyX[i] - playerX) <= 2 &&
                        enemyY[i] >= H - 5)
                    {
                        active[i] = 0;
                    }
                }

                if (lives <= 0)
                {
                    gameOver = 1;
                }
                else
                {
                    drawGame(speedLevel);
                    Sleep(700);
                }
            }

            if (score > highScore)
                highScore = score;

            drawGame(speedLevel);
            Sleep(delay);
        }

        /* Game over screen */
        drawGame(speedLevel);

        printf("\n******** GAME OVER ********\n");
        printf("Final Score : %d\n", score);
        printf("High Score  : %d\n", highScore);
        printf("Lives Left  : %d\n", lives);
        printf("Near Misses : %d\n", nearMisses);

        printf("\nPress R to Restart or Q to Quit.\n");

        while (1)
        {
            key = getch();

            if (key == 'r' || key == 'R')
                break;

            if (key == 'q' || key == 'Q')
                return 0;
        }
    }

    return 0;
}
